{
  "name": "@zerodtree/quartz-v5-plugin-top-card",
  "version": "0.1.0",
  "description": "Site header navigation bar for Quartz v5.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroDtree/quartz-v5-plugin-top-card"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/darkmode": "^0.1.0",
    "@quartz-community/reader-mode": "^0.1.0",
    "@quartz-community/search": "^0.1.0",
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "preact": "^10.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "quartz": {
    "name": "quartz-v5-plugin-top-card",
    "displayName": "Top Card Nav",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "links": [
        {
          "id": "home",
          "label": "主页",
          "href": "index"
        },
        {
          "id": "friends",
          "label": "友链",
          "href": "friends"
        },
        {
          "id": "about",
          "label": "关于",
          "href": "关于"
        },
        {
          "id": "tags",
          "label": "标签",
          "href": "tags"
        }
      ]
    },
    "components": {
      "TopCard": {
        "displayName": "Top Card Nav",
        "defaultPosition": "header",
        "defaultPriority": 5
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}
